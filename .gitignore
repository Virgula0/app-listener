# Build output
build/linux/

# Generated BPF bindings (intermediate)
build/generated/
build/test
build/pprof

# BPF compiled objects + bpf2go bindings (generated by `make generate`).
# NOTE: the embedded objects are named `<name>_bpf.o` (underscore), so the old
# `*.bpf.o` pattern never matched them and they ended up committed — which is
# how a release shipped BPF objects compiled against one developer's kernel.
# Match both spellings and the whole embeds/ tree.
*.bpf.o
*_bpf.o
internal/*/embeds/*.o
internal/monitor/monitor_bpf.go
internal/guard/guard_bpf.go
internal/networkmonitor/networkmonitor_bpf.go
internal/networkguard/guardnet_bpf.go

# vmlinux.h is generated from BTF
vmlinux.h

# IDE / local
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Compiled exploit binaries (C sources are tracked)
integrationtests/exploits/*
!integrationtests/exploits/*.c
!integrationtests/exploits/Makefile
!integrationtests/exploits/README.md