# /etc/pacman.d/hooks/50-app-listener-reload.hook
#
# After every pacman install/upgrade, re-scan the app-listener catalog
# whitelist: deleted binaries are dropped, new ones are picked up, and
# glob patterns are re-expanded. The daemon is restarted automatically.
#
# The previous approach only sent SIGHUP to re-read inodes; the full
# catalog rescan subsumes that — the daemon is reloaded by
# EnableAndVerify after writing the refreshed config.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Refreshing app-listener whitelist from catalog
When = PostTransaction
Exec = /usr/local/bin/app-listener install --update-catalog-only --yes
