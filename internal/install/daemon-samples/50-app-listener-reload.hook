# /etc/pacman.d/hooks/50-app-listener-reload.hook
#
# After every pacman install/upgrade, re-scan the app-listener catalog
# whitelist: deleted binaries are dropped, new ones are picked up, and
# glob patterns are re-expanded.
#
# With the daemon running the refresh is --live: the daemon keeps guarding,
# apps keep their files open, and a changed whitelist arrives by SIGHUP.
# Only a stopped daemon takes the offline flow, which unlocks encrypted
# resources under an ephemeral self-only guard for the re-scan and starts
# the daemon afterwards.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Refreshing app-listener whitelist from catalog
When = PostTransaction
Exec = /bin/sh -c 'if systemctl is-active --quiet app-listener-daemon; then exec /usr/local/bin/app-listener install --update-catalog-only --live --yes; fi; exec /usr/local/bin/app-listener install --update-catalog-only --yes'
