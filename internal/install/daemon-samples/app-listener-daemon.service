[Unit]
Description=app-listener daemon (eBPF LSM directory guard)
Documentation=https://github.com/Virgula0/app-listener
After=local-fs.target
# The guard pins its LSM links into /sys/fs/bpf so they keep enforcing across
# a SIGKILL; that mount must be up first.
Wants=sys-fs-bpf.mount
After=sys-fs-bpf.mount

[Service]
Type=simple
ExecStart=/usr/local/sbin/app-listener daemon --headless --blocked-only
ExecReload=/bin/kill -HUP $MAINPID
# Safety net for a SIGKILL / crash / startup timeout: the guard's LSM links
# are pinned to /sys/fs/bpf, so the guarded trees stay ENFORCED even after
# the process dies; this then force-locks every encryption root, so the vault
# key is gone too. systemd runs ExecStopPost after EVERY exit. The next start
# retires the stale pins once its own guards are attached.
ExecStopPost=-/usr/local/sbin/app-listener daemon --lockdown
Restart=on-failure
RestartSec=2s
# The daemon only exits after every watched directory is locked again; a
# process holding open files in one of them can make that take a while.
# Never SIGKILL it mid-lockdown — that would leave the trees unlocked and
# unguarded.
TimeoutStopSec=infinity
# Startup unlocks vaults and attaches guards; it now catches SIGTERM/SIGINT
# and locks back on abort, but a hard SIGKILL from a startup timeout would
# still leave vaults unlocked until ExecStopPost runs. Give startup room to
# finish (a large tree scan is slow) rather than race that timeout.
TimeoutStartSec=900

User=root
Group=root

PrivateTmp=yes
ProtectSystem=yes
# NOTE: do NOT add /etc/app-listener here. ProtectSystem=yes already leaves
# /etc writable, and the daemon process never writes there (only `install`
# does). Listing it forces systemd to bind-mount /etc/app-listener when it
# sets up the unit's mount namespace — and once the daemon's read-only
# self-protection guard is attached, that bind mount is denied, so every
# namespaced helper (ExecReload=/bin/kill …) fails with 226/NAMESPACE and
# `systemctl reload` breaks.
ReadWritePaths=/run
NoNewPrivileges=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=app-listener-daemon

[Install]
WantedBy=multi-user.target
