[Unit]
Description=app-listener daemon (eBPF LSM directory guard)
Documentation=https://github.com/Virgula0/app-listener
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/app-listener daemon --headless --blocked-only
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# The daemon only exits after every watched directory is locked again; a
# process holding open files in one of them can make that take a while.
# Never SIGKILL it mid-lockdown — that would leave the trees unlocked and
# unguarded.
TimeoutStopSec=infinity

User=root
Group=root

PrivateTmp=yes
ProtectSystem=yes
ReadWritePaths=/run /etc/app-listener
NoNewPrivileges=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=app-listener-daemon

[Install]
WantedBy=multi-user.target
